{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/downloads/(.*).apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"NoaAI-v1.0.0.apk\"" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/forgot(/.*)?", "dest": "/forgot/index.html" },
    { "src": "/email-verify(/.*)?", "dest": "/email-verify/index.html" },
    { "src": "/verify(/.*)?", "dest": "/email-verify/index.html" },
    { "src": "/reset(/.*)?", "dest": "/reset/index.html" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
